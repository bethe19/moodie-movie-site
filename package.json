{
  "name": "moodie-movie-site",
  "version": "1.0.1",
  "description": "A mood-based movie discovery platform powered by TMDB API, built with HTML, CSS, JavaScript, and Node.js",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm install",
    "test": "jest --coverage",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "vercel-build": "npm install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bethe19/moodie-movie-site.git"
  },
  "keywords": [
    "movies",
    "mood-based",
    "nodejs",
    "express",
    "tmdb-api",
    "javascript",
    "web-app"
  ],
  "author": "Bethe <https://github.com/bethe19>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bethe19/moodie-movie-site/issues"
  },
  "homepage": "https://github.com/bethe19/moodie-movie-site#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.19.0",
    "express-rate-limit": "^7.1.5",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}